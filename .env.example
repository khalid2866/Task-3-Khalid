# ── Image Generation Studio · environment template ──────────────────────────
# Copy this file to ".env" and fill in the keys you have.
# The built-in "demo" engine needs NO keys and works fully offline.

# OpenAI — gpt-image series (DALL-E 3 was retired March 2026; use gpt-image)
OPENAI_API_KEY=
GPT_IMAGE_MODEL=gpt-image-1

# Stability AI — Stable Image Core (REST v2beta)
STABILITY_API_KEY=

# Alibaba Cloud Model Studio (DashScope) — Wan Text-to-Image v2
DASHSCOPE_API_KEY=
WAN_MODEL=wan2.1-t2i-plus

# Studio settings (optional overrides)
# STUDIO_OUTPUT_DIR=outputs
# STUDIO_QA_THRESHOLD=7.0
